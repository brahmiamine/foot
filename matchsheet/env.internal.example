# Variables à ajouter à .env.local pour les appels internes vers
# teamManager (cartons -> amende/suspension) et superadmin (statut du
# match). Secret distinct de SSO_JWT_SECRET : celui-ci authentifie des
# appels app-à-app, pas des sessions utilisateur.

INTERNAL_API_SECRET=change-me-to-a-long-random-secret
TEAMMANAGER_URL=https://teammanager.tondomaine.com
SUPERADMIN_URL=https://superadmin.tondomaine.com
