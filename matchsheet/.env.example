# Base de données partagée avec sso/arbinote/superadmin/teamManager
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot

# matchsheet est un kiosque sans écran de login (pas de redirection SSO côté
# UI), mais src/middleware.ts et src/lib/ssoSession.ts vérifient tout de même
# le cookie partagé pour les routes qui en ont besoin. Doivent être
# IDENTIQUES aux autres apps (voir sso/.env.example).
SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=

# Optionnel : si absentes, les notifications sont simplement désactivées
# (aucune erreur, voir src/lib/notificationClient.ts). Clé de service propre
# à matchsheet, déclarée côté notification-api dans
# SERVICE_API_KEYS={"matchsheet":"<cette-clé>", ...}.
NOTIFICATION_API_URL=http://localhost:3010
NOTIFICATION_API_KEY=change-me-to-a-long-random-secret

# Requis pour /api/internal/* (TS-31, avancement.md) : réouverture de
# feuille demandée par superadmin (voir superadmin/src/lib/matchsheetClient.ts
# et src/lib/serviceAuth.ts). Sans cette clé, ces routes répondent 503 —
# superadmin ne peut alors plus rouvrir de match. Doit être IDENTIQUE à
# MATCHSHEET_SERVICE_API_KEY côté superadmin.
MATCHSHEET_SERVICE_API_KEY=change-me-to-a-long-random-secret
