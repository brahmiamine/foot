# Base partagée avec identity, federation-hub et match-operations
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot

# Identity / cookie SSO partagé
SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=
SSO_REVOCATION_FAILURE_MODE=closed

# Destination du bouton « Ouvrir la feuille de match »
MATCH_OPERATIONS_URL=http://localhost:3001

# Optionnel : compteur de notifications non lues (best effort)
NOTIFICATION_API_URL=http://localhost:3010
