# Base de données partagée avec matchsheet/arbinote/superadmin/teamManager
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot

# Secret partagé pour signer/vérifier les sessions SSO — DOIT être IDENTIQUE
# dans les 6 apps (sso, matchsheet, arbinote, superadmin, teamManager, ob).
# `ob` ne fait que vérifier le cookie (espace membre), comme les 4 apps
# back-office : seul `sso` signe.
SSO_JWT_SECRET=change-me-to-a-long-random-secret

# Nom du cookie de session — DOIT être identique dans les 6 apps.
SSO_COOKIE_NAME=foot_sso_session

# Domaine parent du cookie, pour qu'il soit visible par tous les
# sous-domaines (ex: ".foot.tn" si les apps sont sur sso.foot.tn,
# superadmin.foot.tn, arbinote.foot.tn, teammanager.foot.tn,
# matchsheet.foot.tn, ob.foot.tn/www.foot.tn). Laisser VIDE en local : un
# cookie sans Domain est déjà partagé entre les ports d'un même hostname
# ("localhost").
SSO_COOKIE_DOMAIN=

# Identifiants OAuth Google (console Google Cloud), pour "Se connecter avec
# Google" sur l'espace membre (/membre/login, /membre/register). Redirect
# URI autorisée à déclarer côté Google : <origine de sso>/api/auth/google/callback
# (ex: http://localhost:3000/api/auth/google/callback en local).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Utilisé uniquement par `pnpm seed:superadmin` pour créer le premier compte.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# URL publique de cette app, pour construire le lien de réinitialisation de
# mot de passe envoyé par email (src/lib/passwordReset.ts). Par défaut
# http://localhost:3004 si absent.
SSO_URL=http://localhost:3004

# SMTP pour l'email de réinitialisation de mot de passe. En l'absence de
# SMTP_USER/SMTP_PASS, l'email est simplement logué en console (mode dev),
# voir src/lib/mailer.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@foot-platform.tn
