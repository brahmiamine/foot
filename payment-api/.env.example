# Node
NODE_ENV=development
PORT=3000

# Konnect (https://docs.konnect.network)
# Sandbox: https://api.sandbox.konnect.network/api/v2
# Production: https://api.konnect.network/api/v2
KONNECT_BASE_URL=https://api.sandbox.konnect.network/api/v2
# Never commit a real API key. Get one from your Konnect dashboard.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# Publicly reachable HTTPS URL Konnect will call on payment status changes.
KONNECT_WEBHOOK_URL=https://your-domain.example.com/payments/konnect/webhook

# Paymee (https://www.paymee.tn)
# Sandbox: https://sandbox.paymee.tn/api/v2
# Production: https://app.paymee.tn/api/v2
PAYMEE_BASE_URL=https://sandbox.paymee.tn/api/v2
# Never commit a real API key. Get one from your Paymee dashboard.
PAYMEE_API_KEY=
# Publicly reachable HTTPS URL Paymee will call on payment status changes.
PAYMEE_WEBHOOK_URL=https://your-domain.example.com/payments/providers/paymee/webhook
# Where the payer is redirected after completing/cancelling payment (redirection mode).
PAYMEE_RETURN_URL=https://your-domain.example.com/payment/return
PAYMEE_CANCEL_URL=https://your-domain.example.com/payment/cancel

# Flouci (https://docs.flouci.com)
# Same base URL for Sandbox and Production; credentials differ between environments.
FLOUCI_BASE_URL=https://developers.flouci.com
# Never commit real keys. Get them from your Flouci dashboard.
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
# Publicly reachable HTTPS URL Flouci will call on payment status changes.
FLOUCI_WEBHOOK_URL=https://your-domain.example.com/payments/providers/flouci/webhook
# Where the payer is redirected after a successful/failed payment.
FLOUCI_SUCCESS_URL=https://your-domain.example.com/payment/success
FLOUCI_FAIL_URL=https://your-domain.example.com/payment/fail

# Applications internes autorisées à appeler POST /payments/*/init et
# GET /payments/:id (header x-api-key). JSON { "application": "clé" } — une
# clé distincte par application, jamais partagée. Les webhooks providers
# (Konnect/Paymee/Flouci) ne portent jamais cette clé : ils sont
# authentifiés par re-vérification serveur-à-serveur / checksum.
SERVICE_API_KEYS={"ob":"","teamManager":"","sellerPortal":"","billetterie":"","marketplace-api":""}

# notification-api (optional — voir ../notification-api). Si absentes, un
# paiement confirmé ne notifie simplement pas le payeur (aucune erreur).
# NOTIFICATION_API_KEY doit être déclarée côté notification-api dans
# SERVICE_API_KEYS={"payment-api":"<cette-clé>", ...}.
NOTIFICATION_API_URL=http://localhost:3010
NOTIFICATION_API_KEY=

# Database (internal payment records)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=payment_api
DB_PASSWORD=
DB_DATABASE=payment_api
