# Base de données partagée avec identity/arbinote/federation-hub/club-hub
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot

# Identity / SSO
SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=
SSO_REVOCATION_FAILURE_MODE=closed

# Notifications best effort
NOTIFICATION_API_URL=http://localhost:3010
NOTIFICATION_API_KEY=change-me-to-a-long-random-secret

# API interne propre à match-operations
MATCH_OPERATIONS_SERVICE_API_KEY=change-me-to-a-long-random-secret

# Match -> Fédération : décisions réglementaires. Les deux variables doivent
# être présentes ensemble ; sinon l'adapter shared-DB de transition est utilisé
# uniquement lorsque les deux sont absentes.
FEDERATION_REGULATORY_URL=
FEDERATION_REGULATORY_SERVICE_API_KEY=

# Match -> Referee : indisponibilités des officiels.
REFEREE_HUB_URL=
REFEREE_HUB_SERVICE_API_KEY=

# Match -> Club : lecture des compositions officielles appartenant à club-hub.
# Sans ces deux valeurs, le read adapter shared-DB reste actif pendant la
# transition. Avec les deux, LineupService et EligibilityService lisent via
# /api/internal/matches/:matchId/lineup. Une configuration partielle échoue.
CLUB_HUB_SERVICE_URL=
CLUB_HUB_SERVICE_API_KEY=
