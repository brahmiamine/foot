# Base de données partagée avec identity/arbinote/federation-hub/club-hub
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot

# match-operations est un kiosque sans écran de login (pas de redirection SSO côté
# UI), mais src/middleware.ts et src/lib/ssoSession.ts vérifient tout de même
# le cookie partagé pour les routes qui en ont besoin. Doivent être
# IDENTIQUES aux autres apps (voir identity/.env.example).
# TASK-P0-001 : vérification contre le JWKS public de `sso` (SSO_URL +
# /api/.well-known/jwks.json). SSO_JWT_SECRET = fallback legacy HS256.
SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=

# TS-29 : si sso est injoignable, refuser l'accès plutôt que de retomber sur
# le résultat cryptographique local (fail-closed) — recommandé pour ce
# back-office. "open" (comportement historique) si absent. Voir
# packages/auth-shared/src/session.ts.
SSO_REVOCATION_FAILURE_MODE=closed

# Optionnel : si absentes, les notifications sont simplement désactivées
# (aucune erreur, voir src/lib/notificationClient.ts). Clé de service propre
# à match-operations, déclarée côté notifications dans
# SERVICE_API_KEYS={"match-operations":"<cette-clé>", ...}.
NOTIFICATION_API_URL=http://localhost:3010
NOTIFICATION_API_KEY=change-me-to-a-long-random-secret

# Requis pour /api/internal/* (TS-31, avancement.md) : réouverture de
# feuille demandée par federation-hub (voir federation-hub/src/lib/matchOperationsClient.ts
# et src/lib/serviceAuth.ts). Sans cette clé, ces routes répondent 503 —
# federation-hub ne peut alors plus rouvrir de match. Doit être IDENTIQUE à
# MATCH_OPERATIONS_SERVICE_API_KEY côté federation-hub.
MATCH_OPERATIONS_SERVICE_API_KEY=change-me-to-a-long-random-secret

# Migration architecture Match -> Fédération : optionnel pendant la phase de
# transition. Si LES DEUX variables sont absentes, EligibilityService et
# StaffEligibilityService continuent à utiliser les adapters read-only de la
# base partagée. Si les deux sont présentes, ils passent par le client HTTP
# @foot/regulatory-client. Une configuration partielle est refusée (fail-closed).
# Ne pas activer avant que federation-hub expose les routes internes
# /api/internal/regulatory/eligibility/player et /head-coach.
FEDERATION_REGULATORY_URL=
FEDERATION_REGULATORY_SERVICE_API_KEY=
