# Base de données partagée avec sso/matchsheet/arbinote/superadmin
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot
DB_LOGGING=false

# Doivent être IDENTIQUES dans les apps sso/matchsheet/arbinote/superadmin/
# teamManager (voir sso/.env.example) : seul `sso` signe, les autres
# vérifient seulement le même cookie.
SSO_URL=http://localhost:3004
NEXT_PUBLIC_SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=

# Optionnel : si absentes, les notifications sont simplement désactivées
# (aucune erreur, voir src/lib/notificationClient.ts). Clé de service propre
# à teamManager, déclarée côté notification-api dans
# SERVICE_API_KEYS={"teamManager":"<cette-clé>", ...}.
NOTIFICATION_API_URL=http://localhost:3010
NOTIFICATION_API_KEY=change-me-to-a-long-random-secret

# Paiement réel de la boutique club (/boutique/[teamId]) via ../payment-api
# (voir son README pour le détail des endpoints) — mêmes variables que
# billetterie/.env.example, premier appelant de payment-api du dépôt.
# URL server-side uniquement, jamais exposée au navigateur.
PAYMENT_API_URL=http://localhost:3006
# Clé propre à teamManager, déclarée côté payment-api dans
# SERVICE_API_KEYS={"teamManager":"<cette-clé>", ...}.
PAYMENT_API_KEY=change-me-to-a-long-random-secret
# konnect ou flouci uniquement (voir src/lib/paymentApiClient.ts) : paymee
# exige firstName/lastName/phoneNumber, des champs que le profil MEMBER de
# `sso` ne collecte pas aujourd'hui.
PAYMENT_PROVIDER=konnect

# Clé publique VAPID pour l'abonnement Web Push côté navigateur (/admin/mon-compte,
# voir src/components/PushSubscribeButton.tsx) — DOIT être la même paire que
# WEB_PUSH_PUBLIC_KEY/WEB_PUSH_PRIVATE_KEY dans notification-api/.env. Exposée
# au client (NEXT_PUBLIC_), c'est la clé publique — sans risque.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
