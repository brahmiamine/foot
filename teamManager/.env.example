# Base de données partagée avec sso/matchsheet/arbinote/superadmin
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot
DB_LOGGING=false

# Doivent être IDENTIQUES dans les apps sso/matchsheet/arbinote/superadmin/
# teamManager (voir sso/.env.example) : seul `sso` signe, les autres
# vérifient seulement le même cookie.
SSO_URL=http://localhost:3004
NEXT_PUBLIC_SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=

# Optionnel : si absentes, les notifications sont simplement désactivées
# (aucune erreur, voir src/lib/notificationClient.ts). Clé de service propre
# à teamManager, déclarée côté notification-api dans
# SERVICE_API_KEYS={"teamManager":"<cette-clé>", ...}.
NOTIFICATION_API_URL=http://localhost:3010
NOTIFICATION_API_KEY=change-me-to-a-long-random-secret

# Clé publique VAPID pour l'abonnement Web Push côté navigateur (DOIT être la
# même paire que WEB_PUSH_PUBLIC_KEY/WEB_PUSH_PRIVATE_KEY dans
# notification-api/.env). Exposée au client (NEXT_PUBLIC_), c'est la clé
# publique — sans risque.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Boutique client (/boutique, voir src/services/ShopOrderService.ts) via
# ../payment-api. URL server-side uniquement, jamais exposée au navigateur.
PAYMENT_API_URL=http://localhost:3006
# Clé propre à teamManager, déclarée côté payment-api dans
# SERVICE_API_KEYS={"teamManager":"<cette-clé>", ...}.
PAYMENT_API_KEY=change-me-to-a-long-random-secret
# konnect, flouci ou paymee (voir src/lib/paymentApiClient.ts). Avec paymee,
# la commande échoue proprement si le membre n'a pas encore renseigné
# prénom/nom/téléphone dans son profil (requis par le DTO Paymee).
PAYMENT_PROVIDER=konnect
# Webhook applicatif entrant depuis payment-api (POST /api/payments/webhook,
# header X-Payment-Signature: sha256=<hmac-sha256 du corps>) — même secret
# que WEBHOOK_URLS/PAYMENT_WEBHOOK_SECRET côté payment-api pour teamManager.
# Sans cette variable, la route répond 401 et teamManager garde uniquement
# sa reconciliation par polling existante (retour payeur / "mes commandes").
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-secret
