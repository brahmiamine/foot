# Base de données partagée avec identity/match-operations/arbinote/federation-hub/
# club-hub/player-hub/staff-hub (medical-hub lit et écrit la table
# cms_injuries déjà possédée par club-hub — accès réservé aux comptes ayant
# la permission medical.view/medical.manage, voir club-hub/src/lib/permissions.ts).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot

# Doivent être IDENTIQUES à identity/.env.example (voir club-hub/.env.example,
# même remarque) : medical-hub ne signe jamais de session, il vérifie
# seulement le cookie SSO émis par `identity`.
SSO_URL=http://localhost:3004
NEXT_PUBLIC_SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=

# Recommandé pour un module à données sensibles (voir avancement.md TS-29) :
# révocation immédiate plutôt que d'attendre l'expiration du JWT (12h).
SSO_REVOCATION_FAILURE_MODE=closed

# Notifications (rappels de suivi...) — même convention que
# player-hub/staff-hub : le JWT de l'utilisateur est relayé tel quel
# (Authorization: Bearer), aucune clé de service nécessaire ici.
NOTIFICATION_API_URL=http://localhost:3010

# URL publique de l'app (redirections après connexion).
NEXT_PUBLIC_APP_URL=http://localhost:3009
