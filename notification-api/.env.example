# Node
NODE_ENV=development
PORT=3010

# SSO (JWT partagé — même secret que sso/.env, voir sso/src/lib/session.ts)
SSO_JWT_SECRET=
SSO_JWT_ISSUER=foot-sso
SSO_COOKIE_NAME=foot_sso_session
# Optionnel : active la vérification de révocation (tokenVersion) auprès de
# sso en plus de signature/expiration, voir SsoJwtService.verify.
SSO_URL=http://localhost:3004

# Applications internes autorisées à appeler /internal/* (§21).
# JSON { "application": "clé" } — une clé distincte par application, jamais partagée.
SERVICE_API_KEYS={"teamManager":"","ob":"","matchsheet":"","arbinote":"","superadmin":"","payment-api":"","marketplace-api":"","sellerPortal":""}

# Database (données propres au notification-api : notifications, préférences, templates, ...)
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=notification_api

# Base partagée `foot` (lecture seule) — résolution des cibles broadcast
# TEAM/ROLE/MEMBERS (§22) et branding club (§34). Laisser vide pour désactiver
# (seules les cibles USER explicites fonctionneront alors).
DIRECTORY_DB_HOST=localhost
DIRECTORY_DB_PORT=3307
DIRECTORY_DB_USERNAME=root
DIRECTORY_DB_PASSWORD=
DIRECTORY_DB_DATABASE=foot

# Redis (BullMQ — envoi asynchrone, §17)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (§15) — EMAIL_PROVIDER=smtp|resend|sendgrid
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@foot.tn
RESEND_API_KEY=
SENDGRID_API_KEY=

# Push (§16)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:contact@foot.tn
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Rétention (§24, §27) : purge quotidienne des notifications plus vieilles que N jours.
NOTIFICATION_RETENTION_DAYS=180
