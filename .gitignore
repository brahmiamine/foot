.DS_Store
Skote_React_v4.4.0/
db/*.zip
# Sauvegardes produites par db/backup.sh (dump SQL + uploads, potentiellement
# des données personnelles) — jamais commitées, voir db/restore.sh.
db/backups/

# Installation unique du workspace pnpm racine (voir pnpm-workspace.yaml et
# pnpm-lock.yaml) : chaque application garde un node_modules local hoisté
# depuis le store pnpm partagé, mais aucun lockfile ni node_modules ne sont
# suivis par git.
node_modules/

# Cache local Turborepo (turbo run build/lint/test/typecheck).
.turbo/

# Worktrees créés par les agents Claude Code (session-local, non versionnés).
.claude/worktrees/

# Static Storybook build output (packages/ui) — generated, not versioned.
storybook-static/
