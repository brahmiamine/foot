# Base "foot" partagée avec arbinote / superadmin / teamManager / sso / ob
# (voir ../start.sh à la racine du repo).
DB_HOST=localhost
DB_PORT=3306
DB_USER=arbitres
DB_PASSWORD=change-me
DB_NAME=foot

# Espace membre : ce site ne fait que vérifier le cookie de session émis par
# `sso` (voir sso/env.example) — il ne signe jamais de session lui-même.
# SSO_JWT_SECRET et SSO_COOKIE_NAME DOIVENT être identiques à ceux de `sso`.
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session

# URL publique de l'app `sso`, pour rediriger un visiteur non connecté vers
# /membre/login avant l'achat d'un billet.
SSO_URL=http://localhost:3001

# Volontairement AUCUN identifiant de club par défaut ici (contrairement à
# ob/.env.example OB_TEAM_ID) : cette app est générique, un même déploiement
# sert la billetterie de tous les clubs — le club organisateur est toujours
# résolu depuis le match consulté (matches.equipe_home), jamais d'une
# variable d'environnement ou d'une valeur envoyée par le client.

# Paiement réel via ../payment-api (voir son README pour le détail des
# endpoints). URL server-side uniquement, jamais exposée au navigateur.
PAYMENT_API_URL=http://localhost:3006
# Clé propre à billetterie, déclarée côté payment-api dans
# SERVICE_API_KEYS={"billetterie":"<cette-clé>", ...}.
PAYMENT_API_KEY=change-me-to-a-long-random-secret
# konnect, flouci ou paymee (voir src/lib/paymentApiClient.ts). Un seul
# provider actif pour tout ce déploiement, pas un choix par commande — voir
# le commentaire en tête de paymentApiClient.ts pour pourquoi (ce n'est PAS
# une limite de payment-api, qui monte les 3 providers simultanément).
# paymee exige firstName/lastName/phoneNumber : si le profil MEMBER de
# `sso` ne les a pas (voir /membre/profil sur sso), l'achat est bloqué avec
# un message clair plutôt que d'envoyer des champs vides à Paymee.
PAYMENT_PROVIDER=konnect
