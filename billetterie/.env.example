# Base "foot" partagée avec arbinote / superadmin / teamManager / sso / ob
# (voir ../start.sh à la racine du repo).
DB_HOST=localhost
DB_PORT=3306
DB_USER=arbitres
DB_PASSWORD=change-me
DB_NAME=foot

# Espace membre : ce site ne fait que vérifier le cookie de session émis par
# `sso` (voir sso/env.example) — il ne signe jamais de session lui-même.
# SSO_JWT_SECRET et SSO_COOKIE_NAME DOIVENT être identiques à ceux de `sso`.
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session

# URL publique de l'app `sso`, pour rediriger un visiteur non connecté vers
# /membre/login avant l'achat d'un billet.
SSO_URL=http://localhost:3004

# Volontairement AUCUN identifiant de club par défaut ici (contrairement à
# ob/.env.example OB_TEAM_ID) : cette app est générique, un même déploiement
# sert la billetterie de tous les clubs — le club organisateur est toujours
# résolu depuis le match consulté (matches.equipe_home), jamais d'une
# variable d'environnement ou d'une valeur envoyée par le client.

# Paiement réel via ../payment-api (voir son README pour le détail des
# endpoints). URL server-side uniquement, jamais exposée au navigateur.
PAYMENT_API_URL=http://localhost:3006
# Clé propre à billetterie, déclarée côté payment-api dans
# SERVICE_API_KEYS={"billetterie":"<cette-clé>", ...}.
PAYMENT_API_KEY=change-me-to-a-long-random-secret
# konnect, flouci ou paymee (voir src/lib/paymentApiClient.ts). Avec paymee,
# l'achat échoue proprement (message clair) si le membre n'a pas encore
# renseigné prénom/nom/téléphone dans son profil (espace membre côté `ob`,
# voir src/lib/ssoProfileClient.ts) : requis par le DTO Paymee de payment-api.
PAYMENT_PROVIDER=konnect

# Webhook applicatif entrant depuis payment-api (POST /api/payments/webhook,
# header X-Payment-Signature: sha256=<hmac-sha256 du corps>) — même secret
# que WEBHOOK_URLS/PAYMENT_WEBHOOK_SECRET côté payment-api pour ce billetterie.
# Le corps n'est jamais source de vérité : la route relit GET /payments/:id
# avant de marquer les billets PAID. Sans cette variable, la route répond
# 401 et billetterie garde uniquement sa reconciliation par polling
# existante (retour payeur / "mes billets" / cron de purge).
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-secret

# Signature des jetons de contrôle d'accès (QR code affiché sur "mes
# billets", scanné via /admin/scan — voir src/lib/ticketQr.ts). Sans cette
# variable, la génération/vérification de jeton échoue explicitement (pas
# de valeur par défaut en clair pour un secret qui protège l'entrée au
# stade).
TICKET_QR_SECRET=change-me-to-a-long-random-secret

# Secret partagé pour POST /api/cron/purge-pending-reservations (header
# x-cron-secret) : libère les réservations PENDING abandonnées, à appeler
# périodiquement par un ordonnanceur externe (voir README.md). Sans cette
# variable (ou si le header ne correspond pas), la route répond 401.
CRON_SECRET=change-me-to-a-long-random-secret
