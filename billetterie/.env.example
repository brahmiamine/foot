# Base "foot" partagée avec arbinote / superadmin / teamManager / ob (voir
# start.sh à la racine du repo). Lecture des matchs/clubs (`matches`,
# `teams`), écriture des tables propres à la billetterie (`tk_*`).
DB_HOST=localhost
DB_PORT=3306
DB_USER=arbitres
DB_PASSWORD=change-me
DB_NAME=foot

# Cette app ne fait que vérifier le cookie de session émis par `sso` — elle
# ne signe jamais de session elle-même. SSO_JWT_SECRET et SSO_COOKIE_NAME
# DOIVENT être identiques à ceux de `sso`. Seuls les comptes MEMBER peuvent
# acheter un billet (voir README racine, section « Billetterie : séparer
# l'identité du supporter de l'organisateur de l'événement »).
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session

# URL publique de l'app `sso`, pour rediriger un visiteur non connecté vers
# /membre/login avant l'achat.
SSO_URL=http://localhost:3004
