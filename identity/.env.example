# Base de données partagée
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot

# Sessions SSO : RS256 uniquement. Générer la paire avec
# `pnpm jwt:generate-keypair`; le JWKS public est exposé par identity.
SSO_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SSO_JWT_KID=change-me-key-id-1
# Rotation RSA : ancienne clé publiée temporairement dans le JWKS.
SSO_JWT_PRIVATE_KEY_PREVIOUS=
SSO_JWT_KID_PREVIOUS=
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=
SSO_URL=http://localhost:3004

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# Service-to-service Identity
SSO_SERVICE_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@foot-platform.tn
