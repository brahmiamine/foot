# Base de données partagée avec match-operations/arbinote/federation-hub/club-hub
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot

# TASK-P0-001 : clé RSA 2048 (RS256) utilisée pour SIGNER les JWT de
# session. Générer avec `pnpm jwt:generate-keypair` (voir
# docs/jwt-rotation-runbook.md). SSO_JWT_KID identifie la clé dans le
# header du JWT et dans /api/.well-known/jwks.json (JWKS public, consommé
# par les apps clientes via packages/auth-shared et par notifications).
# Ni la clé privée ni SSO_JWT_KID ne sont partagés avec les apps clientes :
# seul `sso` signe, les autres vérifient contre le JWKS public.
SSO_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SSO_JWT_KID=change-me-key-id-1

# Pendant une rotation de clé (fenêtre de grâce), clé précédente encore
# acceptée en VÉRIFICATION (jamais utilisée pour signer). Laisser vide en
# dehors d'une rotation. Voir docs/jwt-rotation-runbook.md.
SSO_JWT_PRIVATE_KEY_PREVIOUS=
SSO_JWT_KID_PREVIOUS=

# Legacy (TASK-P0-001) : secret HS256 encore accepté en VÉRIFICATION SEULE,
# pour les jetons émis avant la migration RS256 ci-dessus, le temps qu'ils
# expirent naturellement (≤12h). `sso` ne signe plus jamais en HS256.
# DOIT rester identique dans les 6 apps clientes tant qu'il est défini.
# Peut être retiré partout une fois la fenêtre de transition passée.
SSO_JWT_SECRET=change-me-to-a-long-random-secret

# Nom du cookie de session — DOIT être identique dans les 6 apps.
SSO_COOKIE_NAME=foot_sso_session

# Domaine parent du cookie, pour qu'il soit visible par tous les
# sous-domaines (ex: ".foot.tn" si les apps sont sur sso.foot.tn,
# federation-hub.foot.tn, arbinote.foot.tn, teammanager.foot.tn,
# match-operations.foot.tn, ob.foot.tn/www.foot.tn). Laisser VIDE en local : un
# cookie sans Domain est déjà partagé entre les ports d'un même hostname
# ("localhost").
SSO_COOKIE_DOMAIN=

# Identifiants OAuth Google (console Google Cloud), pour "Se connecter avec
# Google" sur l'espace membre (/membre/login, /membre/register). Redirect
# URI autorisée à déclarer côté Google : <origine de sso>/api/auth/google/callback
# (ex: http://localhost:3000/api/auth/google/callback en local).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Utilisé uniquement par `pnpm seed:federation-hub` pour créer le premier compte.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# TS-53/TS-54 (Epic E17) : clé de service pour /api/internal/users/*
# (création/désactivation/réactivation/suppression de comptes staff par une
# autre app — aujourd'hui `federation-hub`, voir lib/identityClient.ts côté
# federation-hub et SSO_SERVICE_API_KEY dans son .env.example). Même valeur des
# deux côtés, jamais la session SSO d'un utilisateur.
SSO_SERVICE_API_KEY=
SUPERADMIN_NAME=Super Admin

# URL publique de cette app, pour construire le lien de réinitialisation de
# mot de passe envoyé par email (src/lib/passwordReset.ts). Par défaut
# http://localhost:3004 si absent.
SSO_URL=http://localhost:3004

# SMTP pour l'email de réinitialisation de mot de passe. En l'absence de
# SMTP_USER/SMTP_PASS, l'email est simplement logué en console (mode dev),
# voir src/lib/mailer.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@foot-platform.tn
