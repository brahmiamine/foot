# Base de données partagée avec identity/match-operations/referee-center/federation-hub/club-hub
# (seller-portal ajoute ses propres tables préfixées sp_ dans cette même base).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot

# Session vendeur indépendante du SSO (un vendeur n'est pas un User `sso`) —
# ne jamais réutiliser SSO_JWT_SECRET ici.
SP_JWT_SECRET=change-me-to-a-long-random-secret
SP_COOKIE_NAME=sp_seller_session

# URL publique de l'app (liens dans les emails).
NEXT_PUBLIC_APP_URL=http://localhost:3006

# SMTP pour les emails transactionnels (invitation, notifications). En
# l'absence de SMTP_USER/SMTP_PASS, les emails sont simplement logués en
# console (mode dev), voir src/lib/mailer.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.tn
