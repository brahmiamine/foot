NODE_ENV=development
PORT=3010

# SSO : vérification RS256/JWKS stricte, SSO_URL requis.
SSO_URL=http://localhost:3004
SSO_JWT_ISSUER=foot-sso
SSO_COOKIE_NAME=foot_sso_session

# Clés distinctes par application. Une clé précédente n'est acceptée que si
# SERVICE_API_KEYS_PREVIOUS_EXPIRES_AT est configurée et encore future.
SERVICE_API_KEYS={"club-hub":"","club-ob":"","match-operations":"","arbinote":"","federation-hub":"","payments":"","marketplace":"","seller-portal":"","identity":""}
# SERVICE_API_KEYS_PREVIOUS={"club-hub":""}
# SERVICE_API_KEYS_PREVIOUS_EXPIRES_AT=2026-08-20T00:00:00.000Z

DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=notification_api
# Optionnel : appliquer les migrations TypeORM au démarrage. Préférer
# `npm run migration:run:prod` comme étape de déploiement dédiée.
DB_RUN_MIGRATIONS=false

DIRECTORY_DB_HOST=localhost
DIRECTORY_DB_PORT=3307
DIRECTORY_DB_USERNAME=root
DIRECTORY_DB_PASSWORD=
DIRECTORY_DB_DATABASE=foot

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@foot.tn
RESEND_API_KEY=
SENDGRID_API_KEY=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:contact@foot.tn
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
NOTIFICATION_RETENTION_DAYS=180
