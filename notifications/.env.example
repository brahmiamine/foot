# Node
NODE_ENV=development
PORT=3010

# SSO (JWT, voir identity/src/lib/session.ts). TASK-P0-001 : vérifié contre le
# JWKS public de `sso` (SSO_URL + /api/.well-known/jwks.json, cache 5min) —
# SSO_URL est donc requis (plus seulement optionnel pour la révocation).
# SSO_JWT_SECRET n'est plus qu'un fallback legacy HS256, voir
# identity/docs/jwt-rotation-runbook.md.
SSO_JWT_SECRET=
SSO_JWT_ISSUER=foot-sso
SSO_COOKIE_NAME=foot_sso_session
SSO_URL=http://localhost:3004

# Applications internes autorisées à appeler /internal/* (§21).
# JSON { "application": "clé" } — une clé distincte par application, jamais partagée.
SERVICE_API_KEYS={"club-hub":"","club-ob":"","match-operations":"","arbinote":"","federation-hub":"","payments":"","marketplace":"","seller-portal":"","identity":""}
# Rotation sans interruption (TASK-P0-003) : pendant une rotation, mettre la
# nouvelle clé dans SERVICE_API_KEYS ci-dessus et l'ancienne ici (même
# format) avec une expiration ISO 8601 ; passé ce délai, seule
# SERVICE_API_KEYS fait foi. Laisser vide en dehors d'une rotation.
# SERVICE_API_KEYS_PREVIOUS={"club-hub":""}
# SERVICE_API_KEYS_PREVIOUS_EXPIRES_AT=2026-08-20T00:00:00.000Z

# Database (données propres au notifications : notifications, préférences, templates, ...)
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=notification_api

# Base partagée `foot` (lecture seule) — résolution des cibles broadcast
# TEAM/ROLE/MEMBERS (§22) et branding club (§34). Laisser vide pour désactiver
# (seules les cibles USER explicites fonctionneront alors).
DIRECTORY_DB_HOST=localhost
DIRECTORY_DB_PORT=3307
DIRECTORY_DB_USERNAME=root
DIRECTORY_DB_PASSWORD=
DIRECTORY_DB_DATABASE=foot

# Redis (BullMQ — envoi asynchrone, §17)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (§15) — EMAIL_PROVIDER=smtp|resend|sendgrid
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@foot.tn
RESEND_API_KEY=
SENDGRID_API_KEY=

# Push (§16)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CONTACT_EMAIL=mailto:contact@foot.tn
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# SMS (TS-44/TS-45, Epic E14) — SMS_PROVIDER=tunisiesms pour activer
# TunisieSmsProvider ; absent/autre valeur => NotImplementedSmsProvider
# (comportement historique, décision produit documentée dans avancement.md).
SMS_PROVIDER=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# Rétention (§24, §27) : purge quotidienne des notifications plus vieilles que N jours.
NOTIFICATION_RETENTION_DAYS=180
