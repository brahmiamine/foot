{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src", "../src", "vite.config.ts"],
  "exclude": ["../src/**/*.test.ts", "../src/**/*.test.tsx", "../vitest.config.ts", "../vitest.setup.ts"]
}
