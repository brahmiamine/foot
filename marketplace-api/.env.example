# Node
NODE_ENV=development
PORT=3011

# Auth vendeur (comptes seller_users, indépendants du SSO commun — voir
# src/auth/seller-jwt.service.ts). Jamais partagé avec un autre secret de
# l'écosystème.
SELLER_JWT_SECRET=

# Applications internes autorisées à appeler les endpoints réservés au club
# (modération produits, gestion des catégories, décisions sur un compte
# vendeur). Header x-api-key. JSON { "application": "clé" } — une clé
# distincte par application, jamais partagée.
SERVICE_API_KEYS={"teamManager":"","superadmin":""}

# Database (dédiée marketplace-api — jamais la base partagée `foot`, voir
# db/OWNERSHIP.md et le même choix pour payment-api/notification-api)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=marketplace_api
DB_PASSWORD=
DB_DATABASE=marketplace_api
