# Node
NODE_ENV=development
PORT=3011

# Auth vendeur (comptes seller_users, indépendants du SSO commun — voir
# src/auth/seller-jwt.service.ts). Jamais partagé avec un autre secret de
# l'écosystème.
SELLER_JWT_SECRET=

# Applications internes autorisées à appeler les endpoints réservés au club
# (modération produits, gestion des catégories, décisions sur un compte
# vendeur) et les endpoints internal/* (sellerPortal, écritures produit
# pour un vendeur déjà authentifié chez lui — voir TS-04). Header x-api-key.
# JSON { "application": "clé" } — une clé distincte par application, jamais
# partagée.
SERVICE_API_KEYS={"teamManager":"","superadmin":"","sellerPortal":""}

# Database partagée avec sso/matchsheet/arbinote/superadmin/teamManager/
# sellerPortal — marketplace-api lit/écrit les tables `sp_*` existantes
# (créées et migrées par sellerPortal), pas une base indépendante. Voir
# TS-04 dans avancement.md : c'est le schéma cible du backlog, différent du
# choix "base dédiée" de payment-api/notification-api.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=foot
