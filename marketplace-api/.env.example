# Node
NODE_ENV=development
PORT=3011

# Auth vendeur (comptes seller_users, indépendants du SSO commun — voir
# src/auth/seller-jwt.service.ts). Jamais partagé avec un autre secret de
# l'écosystème.
SELLER_JWT_SECRET=

# Applications internes autorisées à appeler les endpoints réservés au club
# (modération produits, gestion des catégories, décisions sur un compte
# vendeur) et les endpoints internal/* (sellerPortal, écritures produit
# pour un vendeur déjà authentifié chez lui — voir TS-04). Header x-api-key.
# JSON { "application": "clé" } — une clé distincte par application, jamais
# partagée.
SERVICE_API_KEYS={"teamManager":"","superadmin":"","sellerPortal":""}
# Rotation sans interruption (TASK-P0-003) : pendant une rotation, mettre la
# nouvelle clé dans SERVICE_API_KEYS ci-dessus et l'ancienne ici (même
# format) avec une expiration ISO 8601 ; passé ce délai, seule
# SERVICE_API_KEYS fait foi. Laisser vide en dehors d'une rotation.
# SERVICE_API_KEYS_PREVIOUS={"teamManager":""}
# SERVICE_API_KEYS_PREVIOUS_EXPIRES_AT=2026-08-20T00:00:00.000Z

# Database partagée avec sso/matchsheet/arbinote/superadmin/teamManager/
# sellerPortal — marketplace-api lit/écrit les tables `sp_*` existantes
# (créées et migrées par sellerPortal), pas une base indépendante. Voir
# TS-04 dans avancement.md : c'est le schéma cible du backlog, différent du
# choix "base dédiée" de payment-api/notification-api.
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=foot

# payment-api (TASK-P0-004) : requis pour que le checkout fonctionne
# réellement — sans eux, POST /internal/checkout échoue explicitement
# (503) plutôt que de démarrer en échec. Voir payment-api/.env.example
# pour la clé de service à déclarer côté payment-api
# (SERVICE_API_KEYS={"marketplace-api":"<cette-clé>"}).
PAYMENT_API_URL=http://localhost:3000
PAYMENT_API_KEY=
PAYMENT_PROVIDER=konnect
# Reçoit le webhook applicatif signé de payment-api une fois un paiement
# PAID (POST /payments/webhook) — même secret que côté payment-api
# (PAYMENT_WEBHOOK_SECRET, WEBHOOK_URLS={"marketplace-api":"https://.../payments/webhook"}).
PAYMENT_WEBHOOK_SECRET=

# notification-api (optionnel — voir ../notification-api). Si absentes, une
# commande confirmée ne notifie simplement pas le membre acheteur (les
# vendeurs restent notifiés via le Notification local de ce service).
NOTIFICATION_API_URL=http://localhost:3010
NOTIFICATION_API_KEY=
