# Base de données partagée avec identity/match-operations/arbinote/federation-hub/
# club-hub/player-hub. Les accès cms_roles/cms_user_roles sont désormais
# confinés à un adapter de transition ; la logique applicative passe par Club.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot

# SSO partagé
SSO_URL=http://localhost:3004
NEXT_PUBLIC_SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=
SSO_REVOCATION_FAILURE_MODE=closed

# Staff -> Club : résolution des permissions/catégories effectives. Si LES DEUX
# valeurs sont absentes, l'adapter shared-DB de transition reste utilisé. Avec
# les deux, staff-hub appelle GET /api/internal/access sur club-hub. Une
# configuration partielle est refusée.
CLUB_HUB_SERVICE_URL=
CLUB_HUB_SERVICE_API_KEY=

# Notifications du staff
NOTIFICATION_API_URL=http://localhost:3010

# URL publique de l'app
NEXT_PUBLIC_APP_URL=http://localhost:3008
