# Base de données partagée avec identity/match-operations/arbinote/federation-hub/
# club-hub/player-hub (staff-hub lit/écrit les mêmes tables cms_* que
# club-hub — entraînements, convocations, compositions, statistiques,
# déplacements — sous le même RBAC club-hub, cms_roles/cms_user_roles).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot

# Doivent être IDENTIQUES à identity/.env.example (voir club-hub/.env.example,
# même remarque) : staff-hub ne signe jamais de session, il vérifie
# seulement le cookie SSO émis par `identity`.
SSO_URL=http://localhost:3004
NEXT_PUBLIC_SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=

# Recommandé pour un back-office (voir avancement.md TS-29) : mêmes rôles
# staff que club-hub, mêmes enjeux de révocation immédiate.
SSO_REVOCATION_FAILURE_MODE=closed

# Notifications du staff (convocations envoyées, rappels...) — même
# convention que player-hub/club-hub : le JWT de l'utilisateur est relayé
# tel quel (Authorization: Bearer), aucune clé de service nécessaire ici.
NOTIFICATION_API_URL=http://localhost:3010

# URL publique de l'app (redirections après connexion).
NEXT_PUBLIC_APP_URL=http://localhost:3008
