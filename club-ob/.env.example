# Base "foot" partagée avec arbinote / federation-hub / club-hub (voir start.sh à la racine du repo).
DB_HOST=localhost
DB_PORT=3306
DB_USER=arbitres
DB_PASSWORD=change-me
DB_NAME=foot

# UUID de la ligne `teams` de l'Olympique de Béja. Si absent, résolu au
# démarrage par une recherche sur le nom (`teams.nom LIKE '%Béja%'`) — plus
# lent et moins fiable en cas d'homonymie, donc à renseigner en production.
OB_TEAM_ID=

# Domaine où tourne club-hub, qui héberge les fichiers uploadés
# (/uploads/...) référencés par les entités (news, joueurs, galerie...).
# Laisser vide si ce site est servi derrière le même reverse proxy que
# club-hub (les chemins relatifs suffisent alors).
NEXT_PUBLIC_CLUB_HUB_URL=

# URL publique de l'app `ticketing` (générique, commune à tous les clubs) —
# "Mes billets" de l'espace membre y renvoie plutôt que de réimplémenter la
# ticketing ici. Défaut http://localhost:3005 si absent.
NEXT_PUBLIC_TICKETING_URL=http://localhost:3005

# Espace membre : ce site ne fait que vérifier le cookie de session émis par
# `sso` (voir identity/env.example) — il ne signe jamais de session lui-même.
# SSO_JWT_SECRET et SSO_COOKIE_NAME DOIVENT être identiques à ceux de `sso`.
# TASK-P0-001 : vérification contre le JWKS public de `sso` (SSO_URL +
# /api/.well-known/jwks.json). SSO_JWT_SECRET = fallback legacy HS256.
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session

# URL publique de l'app `sso`, pour rediriger un visiteur non connecté vers
# /membre/login (et le déconnecter via /api/logout).
SSO_URL=http://localhost:3004

# Espace membre : notifications, préférences et Web Push (voir
# notifications/.env.example). Appels serveur-à-serveur uniquement,
# authentifiés par le JWT `sso` de l'utilisateur courant — jamais d'écriture
# directe dans la base `foot` partagée.
NOTIFICATION_API_URL=http://localhost:3010
# Émission d'événements métier (profil modifié, appareil push ajouté/retiré)
# vers notifications via src/lib/notificationClient.ts — sans effet
# bloquant si absente (aucune erreur, voir ce fichier). Clé de service propre
# à `ob`, déclarée côté notifications dans
# SERVICE_API_KEYS={"club-ob":"<cette-clé>", ...}.
NOTIFICATION_API_KEY=change-me-to-a-long-random-secret

# Clé publique VAPID pour l'abonnement Web Push côté navigateur (DOIT être la
# même paire que `WEB_PUSH_PUBLIC_KEY`/`WEB_PUSH_PRIVATE_KEY` dans
# notifications/.env). Exposée au client (NEXT_PUBLIC_), c'est la clé
# publique — sans risque.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
