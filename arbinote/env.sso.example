# Variables à ajouter à .env.local pour l'intégration SSO (voir ../sso).
# ADMIN_USER / ADMIN_PASS / ADMIN_SESSION_SECRET ne sont plus utilisées et
# peuvent être retirées : l'accès au back-office passe désormais par un
# compte SUPERADMIN créé via `pnpm seed:superadmin` dans le projet sso.

# URL publique de l'app sso (server-side, pour rediriger vers /login).
SSO_URL=https://sso.tondomaine.com

# Doivent être IDENTIQUES dans les 5 apps (sso, matchsheet, arbinote,
# superadmin, teamManager).
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=

# Même URL que SSO_URL, mais exposée au navigateur (utilisée par
# src/components/admin/AdminLogin.tsx pour rediriger côté client).
NEXT_PUBLIC_SSO_URL=https://sso.tondomaine.com
