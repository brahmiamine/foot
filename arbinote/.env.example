# Base de données partagée avec identity/match-operations/federation-hub/club-hub
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot
DB_LOGGING=false

# URL publique de l'app (server + client), utilisée pour les liens partagés.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Doivent être IDENTIQUES dans les apps identity/match-operations/arbinote/federation-hub/
# club-hub (voir identity/.env.example) : seul `sso` signe, les autres
# vérifient seulement le même cookie.
# TASK-P0-001 : vérification contre le JWKS public de `sso` (SSO_URL +
# /api/.well-known/jwks.json). SSO_JWT_SECRET = fallback legacy HS256.
SSO_URL=http://localhost:3004
NEXT_PUBLIC_SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=

# Signature des votes anonymes (fingerprint navigateur) — garantit qu'un vote
# n'a pas été falsifié côté client.
FINGERPRINT_PROOF_SECRET=change-me-to-a-long-random-secret

# Optionnel : si absentes, les notifications sont simplement désactivées
# (aucune erreur, voir src/lib/notificationClient.ts). Clé de service propre
# à arbinote, déclarée côté notifications dans
# SERVICE_API_KEYS={"arbinote":"<cette-clé>", ...}.
NOTIFICATION_API_URL=http://localhost:3010
NOTIFICATION_API_KEY=change-me-to-a-long-random-secret

# Clé publique VAPID pour l'abonnement Web Push côté navigateur (DOIT être la
# même paire que WEB_PUSH_PUBLIC_KEY/WEB_PUSH_PRIVATE_KEY dans
# notifications/.env). Exposée au client (NEXT_PUBLIC_), c'est la clé
# publique — sans risque.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Optionnel : balises de vérification des moteurs de recherche.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_YAHOO_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
