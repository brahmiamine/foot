# Base de données partagée avec sso/matchsheet/arbinote/teamManager
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot
DB_LOGGING=false

# Doivent être IDENTIQUES dans les apps sso/matchsheet/arbinote/superadmin/
# teamManager (voir sso/.env.example) : seul `sso` signe, les autres
# vérifient seulement le même cookie.
# TASK-P0-001 : vérification contre le JWKS public de `sso` (SSO_URL +
# /api/.well-known/jwks.json). SSO_JWT_SECRET = fallback legacy HS256.
SSO_URL=http://localhost:3004
NEXT_PUBLIC_SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=

# TS-29 : si sso est injoignable, refuser l'accès plutôt que de retomber sur
# le résultat cryptographique local (fail-closed) — recommandé pour ce
# back-office. "open" (comportement historique) si absent. Voir
# packages/auth-shared/src/session.ts.
SSO_REVOCATION_FAILURE_MODE=closed

# Optionnel : si absentes, les notifications sont simplement désactivées
# (aucune erreur, voir src/lib/notificationClient.ts). Clé de service propre
# à superadmin, déclarée côté notification-api dans
# SERVICE_API_KEYS={"superadmin":"<cette-clé>", ...}.
NOTIFICATION_API_URL=http://localhost:3010
NOTIFICATION_API_KEY=change-me-to-a-long-random-secret

# Requis pour rouvrir un match FINISHED (voir src/lib/matchsheetClient.ts,
# reopenMatchAdmin dans adminMatches.ts) : TS-31 (avancement.md), superadmin
# n'écrit plus directement dans ms_sheets/matches, il appelle désormais
# matchsheet en HTTP. Sans ces variables, la réouverture échoue (erreur
# explicite, pas d'écriture silencieuse). Doit être IDENTIQUE à
# MATCHSHEET_SERVICE_API_KEY côté matchsheet.
MATCHSHEET_URL=http://localhost:3001
MATCHSHEET_SERVICE_API_KEY=change-me-to-a-long-random-secret

# Requis pour créer/désactiver/réactiver/supprimer un compte staff (voir
# src/lib/identityClient.ts, clubAccounts.ts et staffInvitations.ts) : TS-53
# (avancement.md, Epic E17), superadmin n'écrit plus directement dans `User`,
# il appelle désormais sso en HTTP (sso reste seul propriétaire de cette
# table, voir TS-30). SSO_URL est déjà défini ci-dessus. Doit être IDENTIQUE
# à SSO_SERVICE_API_KEY côté sso.
SSO_SERVICE_API_KEY=change-me-to-a-long-random-secret

# SMTP pour les invitations de comptes club (voir src/lib/mailer.ts,
# staffInvitations.ts). En l'absence de SMTP_USER/SMTP_PASS, l'email est
# simplement logué en console (mode dev), l'invitation reste créée en base.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.tn
