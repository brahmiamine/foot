# Variables à ajouter à .env.local.

# Secret partagé pour authentifier les appels internes de matchsheet vers
# PATCH /api/internal/matches/[id]/status. Même valeur que dans
# matchsheet/env.internal.example et teamManager/env.internal.example.
INTERNAL_API_SECRET=change-me-to-a-long-random-secret

# URL publique d'arbinote, exposée au navigateur (dashboard superadmin :
# widget "Alertes de vote" + liens Anomalies/Alertes vers ArbiNote, qui
# n'ont pas d'équivalent local dans superadmin).
NEXT_PUBLIC_ARBINOTE_URL=https://arbinote.tondomaine.com
