# Base "foot" partagée avec arbinote / superadmin / teamManager (voir start.sh à la racine du repo).
DB_HOST=localhost
DB_PORT=3306
DB_USER=arbitres
DB_PASSWORD=change-me
DB_NAME=foot

# UUID de la ligne `teams` de l'Olympique de Béja. Si absent, résolu au
# démarrage par une recherche sur le nom (`teams.nom LIKE '%Béja%'`) — plus
# lent et moins fiable en cas d'homonymie, donc à renseigner en production.
OB_TEAM_ID=

# Domaine où tourne teamManager, qui héberge les fichiers uploadés
# (/uploads/...) référencés par les entités (news, joueurs, galerie...).
# Laisser vide si ce site est servi derrière le même reverse proxy que
# teamManager (les chemins relatifs suffisent alors).
NEXT_PUBLIC_TEAM_MANAGER_URL=

# Espace membre : ce site ne fait que vérifier le cookie de session émis par
# `sso` (voir sso/env.example) — il ne signe jamais de session lui-même.
# SSO_JWT_SECRET et SSO_COOKIE_NAME DOIVENT être identiques à ceux de `sso`.
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session

# URL publique de l'app `sso`, pour rediriger un visiteur non connecté vers
# /membre/login (et le déconnecter via /api/logout).
SSO_URL=http://localhost:3001
