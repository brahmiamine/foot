# Base de données partagée avec identity/match-operations/arbinote/federation-hub
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot
DB_LOGGING=false

# Doivent être IDENTIQUES dans les apps identity/match-operations/arbinote/federation-hub/
# club-hub (voir identity/.env.example) : seul `sso` signe, les autres
# vérifient seulement le même cookie.
# TASK-P0-001 : la vérification se fait désormais contre le JWKS public de
# `sso` (SSO_URL + /api/.well-known/jwks.json, cache 5min) — SSO_URL est
# donc requis. SSO_JWT_SECRET n'est plus qu'un fallback legacy HS256.
SSO_URL=http://localhost:3004
NEXT_PUBLIC_SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=
SSO_REVOCATION_FAILURE_MODE=closed

# Club -> Identity : comptes utilisateurs du club. Pendant la transition, si
# LES DEUX valeurs sont absentes UserService/RoleService utilisent l'adapter
# shared-DB. Avec les deux, création, lecture, modification, suppression et
# validation d'appartenance passent par Identity. Configuration partielle refusée.
IDENTITY_SERVICE_URL=
IDENTITY_SERVICE_API_KEY=

# Notifications
NOTIFICATION_API_URL=http://localhost:3010
NOTIFICATION_API_KEY=change-me-to-a-long-random-secret

# API interne Club / outbox / lecture des compositions par match-operations.
CLUB_HUB_SERVICE_API_KEY=change-me-to-a-long-random-secret
# CLUB_HUB_SERVICE_API_KEY_PREVIOUS=
# CLUB_HUB_SERVICE_API_KEY_PREVIOUS_EXPIRES_AT=2026-08-20T00:00:00.000Z

# Affectation du staff officiel du match dans match-operations.
MATCH_OPERATIONS_URL=http://localhost:3001
MATCH_OPERATIONS_SERVICE_API_KEY=change-me-to-a-long-random-secret

# Web Push
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Paiements boutique
PAYMENT_API_URL=http://localhost:3006
PAYMENT_API_KEY=change-me-to-a-long-random-secret
PAYMENT_PROVIDER=konnect
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-secret

# Marketplace
MARKETPLACE_API_URL=http://localhost:3011
MARKETPLACE_API_KEY=change-me-to-a-long-random-secret
