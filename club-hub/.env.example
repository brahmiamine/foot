# Base de données partagée avec identity/match-operations/arbinote/federation-hub
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot
DB_LOGGING=false

# Doivent être IDENTIQUES dans les apps identity/match-operations/arbinote/federation-hub/
# club-hub (voir identity/.env.example) : seul `sso` signe, les autres
# vérifient seulement le même cookie.
# TASK-P0-001 : la vérification se fait désormais contre le JWKS public de
# `sso` (SSO_URL + /api/.well-known/jwks.json, cache 5min) — SSO_URL est
# donc requis. SSO_JWT_SECRET n'est plus qu'un fallback legacy HS256 (peut
# être retiré une fois la fenêtre de transition passée, voir
# identity/docs/jwt-rotation-runbook.md).
SSO_URL=http://localhost:3004
NEXT_PUBLIC_SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=

# TS-29 : si sso est injoignable, refuser l'accès plutôt que de retomber sur
# le résultat cryptographique local (fail-closed) — recommandé pour ce
# back-office. "open" (comportement historique) si absent. Voir
# packages/auth-shared/src/session.ts.
SSO_REVOCATION_FAILURE_MODE=closed

# Optionnel : si absentes, les notifications sont simplement désactivées
# (aucune erreur, voir src/lib/notificationClient.ts). Clé de service propre
# à club-hub, déclarée côté notifications dans
# SERVICE_API_KEYS={"club-hub":"<cette-clé>", ...}.
NOTIFICATION_API_URL=http://localhost:3010
NOTIFICATION_API_KEY=change-me-to-a-long-random-secret

# TS-25/TS-26 (avancement.md, Epic E07) : clé de service pour
# /api/internal/outbox/process — à invoquer périodiquement par un
# ordonnanceur externe (cron) pour livrer les notifications mises en file
# via l'outbox transactionnel (voir services/NotificationOutboxService.ts).
# club-hub n'a pas de process long-running dédié comme les API NestJS de
# ce dépôt (payments, notifications).
CLUB_HUB_SERVICE_API_KEY=change-me-to-a-long-random-secret
# Rotation sans interruption (TASK-P0-003) : pendant une rotation, mettre la
# nouvelle clé dans CLUB_HUB_SERVICE_API_KEY ci-dessus et l'ancienne ici
# avec une expiration ISO 8601 ; passé ce délai, seule
# CLUB_HUB_SERVICE_API_KEY fait foi. Laisser vide en dehors d'une rotation.
# CLUB_HUB_SERVICE_API_KEY_PREVIOUS=
# CLUB_HUB_SERVICE_API_KEY_PREVIOUS_EXPIRES_AT=2026-08-20T00:00:00.000Z

# Clé publique VAPID pour l'abonnement Web Push côté navigateur (DOIT être la
# même paire que WEB_PUSH_PUBLIC_KEY/WEB_PUSH_PRIVATE_KEY dans
# notifications/.env). Exposée au client (NEXT_PUBLIC_), c'est la clé
# publique — sans risque.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Boutique client (/boutique, voir src/services/ShopOrderService.ts) via
# ../payments. URL server-side uniquement, jamais exposée au navigateur.
PAYMENT_API_URL=http://localhost:3006
# Clé propre à club-hub, déclarée côté payments dans
# SERVICE_API_KEYS={"club-hub":"<cette-clé>", ...}.
PAYMENT_API_KEY=change-me-to-a-long-random-secret
# konnect, flouci ou paymee (voir src/lib/paymentApiClient.ts). Avec paymee,
# la commande échoue proprement si le membre n'a pas encore renseigné
# prénom/nom/téléphone dans son profil (requis par le DTO Paymee).
PAYMENT_PROVIDER=konnect
# Webhook applicatif entrant depuis payments (POST /api/payments/webhook,
# header X-Payment-Signature: sha256=<hmac-sha256 du corps>) — même secret
# que WEBHOOK_URLS/PAYMENT_WEBHOOK_SECRET côté payments pour club-hub.
# Sans cette variable, la route répond 401 et club-hub garde uniquement
# sa reconciliation par polling existante (retour payeur / "mes commandes").
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-secret

# Modération marketplace (/admin/marketplace/products, voir
# src/lib/marketplaceApiClient.ts) via ../marketplace. URL server-side
# uniquement, jamais exposée au navigateur.
MARKETPLACE_API_URL=http://localhost:3011
# Clé propre à club-hub, déclarée côté marketplace dans
# SERVICE_API_KEYS={"club-hub":"<cette-clé>", ...}.
MARKETPLACE_API_KEY=change-me-to-a-long-random-secret
