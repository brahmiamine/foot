DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot

# SSO RS256/JWKS; player-hub ne signe jamais de session.
SSO_URL=http://localhost:3004
NEXT_PUBLIC_SSO_URL=http://localhost:3004
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=
SSO_REVOCATION_FAILURE_MODE=closed

# Mutations du domaine Player : Club Hub reste l'unique propriétaire.
CLUB_HUB_SERVICE_URL=http://localhost:3002
CLUB_HUB_SERVICE_API_KEY=change-me-to-a-long-random-secret

NOTIFICATION_API_URL=http://localhost:3010
NEXT_PUBLIC_APP_URL=http://localhost:3007
