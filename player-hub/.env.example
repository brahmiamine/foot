# Base de données partagée avec identity/match-operations/arbinote/federation-hub/
# club-hub/seller-portal (player-hub lit directement les tables cms_* et les
# tables historiques Player/Card/Suspension/Fine, en lecture seule sauf pour
# les réponses du joueur — convocations, entraînements, déplacements).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot

# Doivent être IDENTIQUES à identity/.env.example : player-hub ne signe
# jamais de session, il vérifie seulement le cookie SSO émis par `identity`
# (voir packages/auth-shared/src/session.ts). SSO_JWT_SECRET n'est qu'un
# fallback legacy HS256 (voir identity/docs/jwt-rotation-runbook.md).
SSO_URL=http://localhost:3004
NEXT_PUBLIC_SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=

# Recommandé pour un espace joueur : un compte désactivé/déconnecté "partout"
# doit perdre l'accès en quelques secondes plutôt qu'attendre l'expiration
# du JWT (jusqu'à 12h). Voir packages/auth-shared/src/session.ts (TS-29).
SSO_REVOCATION_FAILURE_MODE=closed

# Notifications du joueur (convocations, actualités...) — mêmes routes que
# club-hub/src/lib/notificationApi.ts, le JWT du joueur est relayé tel quel
# (Authorization: Bearer), aucune clé de service nécessaire ici.
NOTIFICATION_API_URL=http://localhost:3010

# URL publique de l'app (redirections après connexion).
NEXT_PUBLIC_APP_URL=http://localhost:3007
