# Base de données partagée avec identity/match-operations/arbinote/club-hub
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot
DB_LOGGING=false

# Doivent être IDENTIQUES dans les apps identity/match-operations/arbinote/federation-hub/
# club-hub (voir identity/.env.example) : seul `sso` signe, les autres
# vérifient seulement le même cookie.
# TASK-P0-001 : vérification contre le JWKS public de `sso` (SSO_URL +
# /api/.well-known/jwks.json). SSO_JWT_SECRET = fallback legacy HS256.
SSO_URL=http://localhost:3004
NEXT_PUBLIC_SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=

# TS-29 : si sso est injoignable, refuser l'accès plutôt que de retomber sur
# le résultat cryptographique local (fail-closed) — recommandé pour ce
# back-office. "open" (comportement historique) si absent. Voir
# packages/auth-shared/src/session.ts.
SSO_REVOCATION_FAILURE_MODE=closed

# Optionnel : si absentes, les notifications sont simplement désactivées
# (aucune erreur, voir src/lib/notificationClient.ts). Clé de service propre
# à federation-hub, déclarée côté notifications dans
# SERVICE_API_KEYS={"federation-hub":"<cette-clé>", ...}.
NOTIFICATION_API_URL=http://localhost:3010
NOTIFICATION_API_KEY=change-me-to-a-long-random-secret

# migration-v2 P0-006 : vérification serveur-à-serveur du paiement des droits
# d'engagement. La clé doit identifier federation-hub dans SERVICE_API_KEYS de
# payments. Sans ces variables, une approbation exigeant des droits échoue
# explicitement au lieu de faire confiance au paymentId envoyé par le client.
PAYMENT_API_URL=http://localhost:3006
PAYMENT_API_KEY=change-me-to-a-long-random-secret

# Requis pour rouvrir un match FINISHED (voir src/lib/matchOperationsClient.ts,
# reopenMatchAdmin dans adminMatches.ts) : TS-31 (avancement.md), federation-hub
# n'écrit plus directement dans ms_sheets/matches, il appelle désormais
# match-operations en HTTP. Sans ces variables, la réouverture échoue (erreur
# explicite, pas d'écriture silencieuse). Doit être IDENTIQUE à
# MATCH_OPERATIONS_SERVICE_API_KEY côté match-operations.
MATCH_OPERATIONS_URL=http://localhost:3001
MATCH_OPERATIONS_SERVICE_API_KEY=change-me-to-a-long-random-secret

# Frontière réglementaire interne consommable par match-operations.
# Protège /api/internal/regulatory/* par x-api-key. La valeur doit être
# identique à FEDERATION_REGULATORY_SERVICE_API_KEY côté match-operations.
# Tant que match-operations ne configure pas FEDERATION_REGULATORY_URL + cette
# clé, il conserve automatiquement son adapter shared-DB de transition.
FEDERATION_REGULATORY_SERVICE_API_KEY=change-me-to-a-long-random-secret

# URL publique de l'espace arbitre, utilisée dans les notifications de désignation.
REFEREE_HUB_URL=http://localhost:3009

# TASK-P0-003 (todo.md) : saga d'annulation de match — cancelMatchAdmin
# appelle ticketing (fermeture de la vente + remboursement des billets
# déjà payés) et club-hub (annulation des convocations) en HTTP, voir
# src/lib/matchSagaClients.ts. Sans ces variables, l'étape correspondante
# échoue explicitement (dossier de saga MANUAL_REVIEW) — la valeur doit
# être IDENTIQUE à TICKETING_SERVICE_API_KEY/CLUB_HUB_SERVICE_API_KEY
# côté ticketing/club-hub.
TICKETING_URL=http://localhost:3005
TICKETING_SERVICE_API_KEY=change-me-to-a-long-random-secret
CLUB_HUB_URL=http://localhost:3003
CLUB_HUB_SERVICE_API_KEY=change-me-to-a-long-random-secret

# Requis pour créer/désactiver/réactiver/supprimer un compte staff (voir
# src/lib/identityClient.ts, clubAccounts.ts et staffInvitations.ts) : TS-53
# (avancement.md, Epic E17), federation-hub n'écrit plus directement dans `User`,
# il appelle désormais sso en HTTP (sso reste seul propriétaire de cette
# table, voir TS-30). SSO_URL est déjà défini ci-dessus. Doit être IDENTIQUE
# à SSO_SERVICE_API_KEY côté sso.
SSO_SERVICE_API_KEY=change-me-to-a-long-random-secret

# SMTP pour les invitations de comptes club (voir src/lib/mailer.ts,
# staffInvitations.ts). En l'absence de SMTP_USER/SMTP_PASS, l'email est
# simplement logué en console (mode dev), l'invitation reste créée en base.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.tn
