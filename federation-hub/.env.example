# Base de données partagée avec identity/match-operations/arbinote/club-hub
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foot
DB_LOGGING=false

# Doivent être IDENTIQUES dans les apps identity/match-operations/arbinote/federation-hub/
# club-hub (voir identity/.env.example) : seul `sso` signe, les autres
# vérifient seulement le même cookie.
SSO_URL=http://localhost:3004
NEXT_PUBLIC_SSO_URL=http://localhost:3004
SSO_JWT_SECRET=change-me-to-a-long-random-secret
SSO_COOKIE_NAME=foot_sso_session
SSO_COOKIE_DOMAIN=
SSO_REVOCATION_FAILURE_MODE=closed

# Notifications best effort.
NOTIFICATION_API_URL=http://localhost:3010
NOTIFICATION_API_KEY=change-me-to-a-long-random-secret

# Vérification serveur-à-serveur du paiement des droits d'engagement.
PAYMENT_API_URL=http://localhost:3006
PAYMENT_API_KEY=change-me-to-a-long-random-secret

# Frontière Match.
MATCH_OPERATIONS_URL=http://localhost:3001
MATCH_OPERATIONS_SERVICE_API_KEY=change-me-to-a-long-random-secret

# Frontière réglementaire interne consommable par match-operations.
FEDERATION_REGULATORY_SERVICE_API_KEY=change-me-to-a-long-random-secret

# URL publique de l'espace arbitre, utilisée dans les notifications de désignation.
REFEREE_HUB_URL=http://localhost:3009

# Frontière Referee interne utilisée pour enrichir le sélecteur de désignation
# sans lire directement referee_unavailabilities. Pendant la transition, si
# LES DEUX valeurs sont absentes federation-hub utilise son adapter shared-DB.
# Une configuration partielle est refusée.
REFEREE_HUB_SERVICE_URL=
REFEREE_HUB_SERVICE_API_KEY=

# Frontière Club dédiée aux faits joueur utilisés par l'éligibilité fédérale.
# Ces variables sont volontairement séparées de CLUB_HUB_URL / la clé de saga :
# - les deux absentes => adapter shared-DB de transition ;
# - les deux présentes => appel HTTP vers club-hub ;
# - configuration partielle => erreur fail-closed.
CLUB_PLAYER_FACTS_URL=
CLUB_PLAYER_FACTS_SERVICE_API_KEY=

# Saga annulation/report.
TICKETING_URL=http://localhost:3005
TICKETING_SERVICE_API_KEY=change-me-to-a-long-random-secret
CLUB_HUB_URL=http://localhost:3003
CLUB_HUB_SERVICE_API_KEY=change-me-to-a-long-random-secret

# Identity service-to-service.
SSO_SERVICE_API_KEY=change-me-to-a-long-random-secret

# SMTP invitations.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.tn
